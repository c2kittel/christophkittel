---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found | Christoph Kittel">
  <div class="max-w-2xl mx-auto text-center py-8">
    <h1 class="text-3xl font-black text-slate-900 mb-2 italic">Page Not Found</h1>
    <p class="text-slate-500 mb-8">
      This page doesn't exist — but while you're here, you might help find a missing child.
      This is a <a href="https://notfound.org/en" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline font-medium">NotFound.org</a>
      widget, run by Child Focus / Missing Children Europe.
    </p>

    <iframe
      src="https://notfound-static.fwebservices.be/fr-BE/404?key=6a7496e08fc5d"
      width="100%"
      height="650"
      frameborder="0"
      class="rounded-2xl border border-slate-200 shadow-sm"
      title="NotFound.org missing children notice"
    ></iframe>

    <p class="mt-8">
      <a href="/" class="text-sm font-bold text-blue-600 hover:underline">← Back to the homepage</a>
    </p>
  </div>
</BaseLayout>
